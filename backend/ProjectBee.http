@host = http://localhost:5054
@contentType = application/json

# Senha do usuário demo: a mesma configurada em "Demo:Password" nos user secrets.
@demoEmail = demo@projectbee.dev
@demoPassword = SuaSenhaDemo@123

# Rode na ordem. O login guarda o token e os POSTs de criação guardam os IDs,
# então as requisições seguintes já usam os valores certos.
@token = {{login.response.body.$.token}}
@productId = {{createProduct.response.body.$.id}}
@storageId = {{createStorage.response.body.$.id}}
@storageId2 = {{createStorage2.response.body.$.id}}

# Os PUTs exigem o rowVersion lido antes de editar (concorrência otimista).
# Cada PUT tem um GET logo antes, que guarda a versão atual.
@productRowVersion = {{getProduct.response.body.$.rowVersion}}
@storageRowVersion = {{getStorage.response.body.$.rowVersion}}
@storageRowVersionBeforeDeactivate = {{getStorageBeforeDeactivate.response.body.$.rowVersion}}
@storage2RowVersion = {{getStorage2.response.body.$.rowVersion}}

# Compras: o recebimento e o cancelamento exigem o rowVersion do pedido, que muda a cada operação.
@supplierId = {{createSupplier.response.body.$.id}}
@orderId = {{createOrder.response.body.$.id}}
@orderItemId = {{createOrder.response.body.$.items[0].id}}
@orderRowVersion = {{createOrder.response.body.$.rowVersion}}
@orderRowVersionAfterReceipt = {{receivePartial.response.body.$.rowVersion}}

# Faturamento: pagar o boleto e emitir a nota exigem o rowVersion do pedido de venda.
@customerId = {{createCustomer.response.body.$.id}}
@saleId = {{createSale.response.body.$.id}}
@saleRowVersion = {{createSale.response.body.$.rowVersion}}
@saleRowVersionAfterPayment = {{paySale.response.body.$.rowVersion}}


### =====================================================
### HEALTH CHECK
### =====================================================

GET {{host}}/health


### =====================================================
### AUTENTICAÇÃO
### =====================================================

### Login do demo (Manager) -> 200 com token
# @name login
POST {{host}}/api/auth/login
Content-Type: {{contentType}}

{ "email": "{{demoEmail}}", "password": "{{demoPassword}}" }

### Senha errada -> 401
POST {{host}}/api/auth/login
Content-Type: {{contentType}}

{ "email": "{{demoEmail}}", "password": "senha-errada" }

### Sem token -> 401
GET {{host}}/api/products


### =====================================================
### PRODUTOS
### =====================================================

### Criar produto -> 201 (SKU aleatório para poder repetir)
# @name createProduct
POST {{host}}/api/products
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Mel Silvestre 1kg", "sku": "MEL-1K-{{$randomInt 1000 9999}}", "desc": "Mel silvestre puro, pote 1kg", "price": 59.90 }

### Listar -> 200
GET {{host}}/api/products
Authorization: Bearer {{token}}

### Buscar por ID -> 200 (guarda o rowVersion para o PUT)
# @name getProduct
GET {{host}}/api/products/{{productId}}
Authorization: Bearer {{token}}

### Atualizar -> 200 (isActive é obrigatório)
PUT {{host}}/api/products/{{productId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Mel Silvestre 1kg - Safra 2026", "desc": "Mel silvestre puro, safra 2026, pote 1kg", "price": 64.90, "isActive": true, "rowVersion": "{{productRowVersion}}" }

### Atualizar de novo com a mesma versão -> 409 (o PUT anterior já mudou o rowVersion)
PUT {{host}}/api/products/{{productId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Mel Silvestre 1kg - edição atrasada", "desc": "Outra pessoa salvou antes", "price": 59.90, "isActive": true, "rowVersion": "{{productRowVersion}}" }

### Preço como texto -> 400 com ProblemDetails (corpo que não desserializa)
POST {{host}}/api/products
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Produto Inválido", "sku": "INV-002", "desc": "Preço em texto", "price": "doze reais" }

### Preço zero -> 400
POST {{host}}/api/products
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Produto Inválido", "sku": "INV-001", "desc": "Preço deve ser maior que zero", "price": 0 }

### SKU com minúsculas -> 400 (padrão ^[A-Z0-9-]{3,15}$)
POST {{host}}/api/products
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Produto SKU Inválido", "sku": "mel-500-sil", "desc": "SKU fora do padrão", "price": 10.00 }

### SKU duplicado (o seed já criou MEL-500-SIL) -> 400
POST {{host}}/api/products
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Mel Duplicado", "sku": "MEL-500-SIL", "desc": "SKU já existente", "price": 34.90 }

### Atualizar sem isActive -> 400 (evita desativar sem querer)
PUT {{host}}/api/products/{{productId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Mel Silvestre 1kg", "desc": "Sem isActive", "price": 59.90 }

### ID inexistente -> 404
GET {{host}}/api/products/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}


### =====================================================
### ARMAZÉNS
### =====================================================

### Criar armazém -> 201
# @name createStorage
POST {{host}}/api/storages
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "idNumber": "CPS-{{$randomInt 100 999}}", "name": "Galpão Campinas", "addressNumber": "1250-A", "addressStreet": "Rua das Colmeias", "addressCity": "Campinas" }

### Criar segundo armazém (destino das transferências) -> 201
# @name createStorage2
POST {{host}}/api/storages
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "idNumber": "BRU-{{$randomInt 100 999}}", "name": "Depósito Barueri", "addressNumber": "S/N", "addressStreet": "Avenida Industrial", "addressCity": "Barueri" }

### Listar -> 200
GET {{host}}/api/storages
Authorization: Bearer {{token}}

### Buscar o armazém -> 200 (guarda o rowVersion para o PUT)
# @name getStorage
GET {{host}}/api/storages/{{storageId}}
Authorization: Bearer {{token}}

### Atualizar -> 200 (idNumber não muda; isActive e rowVersion são obrigatórios)
PUT {{host}}/api/storages/{{storageId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Galpão Campinas", "addressNumber": "1250-B", "addressStreet": "Rua das Colmeias", "addressCity": "Campinas", "isActive": true, "rowVersion": "{{storageRowVersion}}" }

### Cidade vazia -> 400
POST {{host}}/api/storages
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "idNumber": "XXX", "name": "Armazém Inválido", "addressNumber": "100", "addressStreet": "Rua Teste", "addressCity": "" }


### =====================================================
### MOVIMENTAÇÕES
### =====================================================

### 1. Entrada em lote novo -> 200, saldoAtual 50
POST {{host}}/api/movements/entry
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "storageId": "{{storageId}}", "batch": "LOTE-TESTE-01", "quantity": 50 }

### 2. Entrada no mesmo lote -> 200, saldoAtual 100
POST {{host}}/api/movements/entry
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "storageId": "{{storageId}}", "batch": "LOTE-TESTE-01", "quantity": 50 }

### 3. Saída -> 200, saldoAtual 70
POST {{host}}/api/movements/exit
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "storageId": "{{storageId}}", "batch": "LOTE-TESTE-01", "quantity": 30 }

### 4. Saída maior que o saldo -> 422 (detail: "Saldo insuficiente. Disponível: 70, solicitado: 500.")
POST {{host}}/api/movements/exit
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "storageId": "{{storageId}}", "batch": "LOTE-TESTE-01", "quantity": 500 }

### 5. Transferência -> 200, saldoAtual 50 (o que sobra na origem)
POST {{host}}/api/movements/transfer
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "fromStorageId": "{{storageId}}", "toStorageId": "{{storageId2}}", "batch": "LOTE-TESTE-01", "quantity": 20 }

### 6. Transferência para o mesmo armazém -> 400
POST {{host}}/api/movements/transfer
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "fromStorageId": "{{storageId}}", "toStorageId": "{{storageId}}", "batch": "LOTE-TESTE-01", "quantity": 5 }

### 7. Ajuste por contagem (contou 47, havia 50) -> 200, saldoAtual 47, movimento de -3
POST {{host}}/api/movements/adjustment
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "storageId": "{{storageId}}", "batch": "LOTE-TESTE-01", "countedQuantity": 47, "reason": "Inventário mensal - 3 unidades avariadas" }

### 8. Mesmo ajuste de novo -> 422 (não há diferença)
POST {{host}}/api/movements/adjustment
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "storageId": "{{storageId}}", "batch": "LOTE-TESTE-01", "countedQuantity": 47, "reason": "Inventário mensal - 3 unidades avariadas" }

### 9. Ajuste sem motivo -> 400
POST {{host}}/api/movements/adjustment
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "storageId": "{{storageId}}", "batch": "LOTE-TESTE-01", "countedQuantity": 40, "reason": "" }

### 10. Lote com minúscula -> 400 (padrão ^[A-Z0-9-]{1,30}$)
POST {{host}}/api/movements/entry
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "storageId": "{{storageId}}", "batch": "lote-teste", "quantity": 10 }

### 11. Histórico do lote na origem -> 200, do mais recente para o mais antigo
GET {{host}}/api/movements?productId={{productId}}&storageId={{storageId}}&batch=LOTE-TESTE-01
Authorization: Bearer {{token}}


### =====================================================
### ESTOQUE (somente leitura)
### =====================================================

### Listar saldos -> 200
GET {{host}}/api/stock
Authorization: Bearer {{token}}

### Tentar gravar saldo direto -> 405 (todo saldo muda por movimento)
POST {{host}}/api/stock
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "storageId": "{{storageId}}", "balance": 999, "batch": "LOTE-TESTE-01" }


### =====================================================
### REGRAS DE DESATIVAÇÃO E EXCLUSÃO
### =====================================================

### Buscar o armazém de novo -> 200 (o PUT anterior mudou o rowVersion)
# @name getStorageBeforeDeactivate
GET {{host}}/api/storages/{{storageId}}
Authorization: Bearer {{token}}

### Desativar armazém com saldo -> 422 (informa lotes e unidades que sobraram)
PUT {{host}}/api/storages/{{storageId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Galpão Campinas", "addressNumber": "1250-B", "addressStreet": "Rua das Colmeias", "addressCity": "Campinas", "isActive": false, "rowVersion": "{{storageRowVersionBeforeDeactivate}}" }

### Excluir armazém com saldo -> 422
DELETE {{host}}/api/storages/{{storageId}}
Authorization: Bearer {{token}}

### Excluir produto com saldo -> 422
DELETE {{host}}/api/products/{{productId}}
Authorization: Bearer {{token}}

### Zerar o destino da transferência (contou 0, havia 20) -> 200
POST {{host}}/api/movements/adjustment
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "productId": "{{productId}}", "storageId": "{{storageId2}}", "batch": "LOTE-TESTE-01", "countedQuantity": 0, "reason": "Zerando para testar a exclusão" }

### Excluir armazém zerado, mas com histórico -> 422 (o caminho é desativar)
DELETE {{host}}/api/storages/{{storageId2}}
Authorization: Bearer {{token}}

### Buscar o segundo armazém -> 200 (guarda o rowVersion para o PUT)
# @name getStorage2
GET {{host}}/api/storages/{{storageId2}}
Authorization: Bearer {{token}}

### Desativar armazém zerado -> 200
PUT {{host}}/api/storages/{{storageId2}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Depósito Barueri", "addressNumber": "S/N", "addressStreet": "Avenida Industrial", "addressCity": "Barueri", "isActive": false, "rowVersion": "{{storage2RowVersion}}" }


### =====================================================
### FORNECEDORES E COMPRAS
### =====================================================

### Criar fornecedor -> 201 (CNPJ aleatório, só dígitos)
# @name createSupplier
POST {{host}}/api/suppliers
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Cooperativa Apícola Serra Azul", "document": "11222333{{$randomInt 100000 999999}}", "email": "vendas@serraazul.dev", "phone": "(11) 4000-1234" }

### CPF com pontuação -> 400 (a API espera só os dígitos)
POST {{host}}/api/suppliers
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Fornecedor pontuado", "document": "123.456.789-09", "email": "", "phone": "" }

### Criar pedido de compra: 30 unidades a R$ 21,00 -> 201, status Open
# @name createOrder
POST {{host}}/api/purchase-orders
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "supplierId": "{{supplierId}}", "storageId": "{{storageId}}", "notes": "Reposição da safra", "items": [ { "productId": "{{productId}}", "quantity": 30, "unitPrice": 21.00 } ] }

### Pedido com o mesmo produto duas vezes -> 400
POST {{host}}/api/purchase-orders
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "supplierId": "{{supplierId}}", "storageId": "{{storageId}}", "items": [ { "productId": "{{productId}}", "quantity": 1, "unitPrice": 1 }, { "productId": "{{productId}}", "quantity": 2, "unitPrice": 1 } ] }

### Receber mais que o pedido -> 422 (pendente 30, informado 35)
POST {{host}}/api/purchase-orders/{{orderId}}/receipts
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "invoiceNumber": "NF-1001", "rowVersion": "{{orderRowVersion}}", "items": [ { "purchaseOrderItemId": "{{orderItemId}}", "batch": "LOTE-COMPRA-01", "quantity": 35, "unitPrice": 21.00 } ] }

### Nota com preço diferente do pedido, sem motivo -> 422 (lista pedido e nota)
POST {{host}}/api/purchase-orders/{{orderId}}/receipts
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "invoiceNumber": "NF-1001", "rowVersion": "{{orderRowVersion}}", "items": [ { "purchaseOrderItemId": "{{orderItemId}}", "batch": "LOTE-COMPRA-01", "quantity": 20, "unitPrice": 22.40 } ] }

### Recebimento parcial com divergência justificada -> 200, status Partial, 20 de 30
# @name receivePartial
POST {{host}}/api/purchase-orders/{{orderId}}/receipts
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "invoiceNumber": "NF-1001", "priceDivergenceReason": "Reajuste de tabela confirmado pelo comprador", "rowVersion": "{{orderRowVersion}}", "items": [ { "purchaseOrderItemId": "{{orderItemId}}", "batch": "LOTE-COMPRA-01", "quantity": 20, "unitPrice": 22.40 } ] }

### Mesma entrega lançada com a versão velha -> 409
POST {{host}}/api/purchase-orders/{{orderId}}/receipts
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "invoiceNumber": "NF-1002", "rowVersion": "{{orderRowVersion}}", "items": [ { "purchaseOrderItemId": "{{orderItemId}}", "batch": "LOTE-COMPRA-01", "quantity": 10, "unitPrice": 21.00 } ] }

### Mesma nota de novo -> 422 (a nota já foi lançada)
POST {{host}}/api/purchase-orders/{{orderId}}/receipts
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "invoiceNumber": "NF-1001", "rowVersion": "{{orderRowVersionAfterReceipt}}", "items": [ { "purchaseOrderItemId": "{{orderItemId}}", "batch": "LOTE-COMPRA-01", "quantity": 1, "unitPrice": 21.00 } ] }

### Excluir fornecedor com pedido parcial -> 422
DELETE {{host}}/api/suppliers/{{supplierId}}
Authorization: Bearer {{token}}

### Cancelar o pendente (10 unidades) -> 200, status Cancelled; as 20 recebidas ficam no estoque
POST {{host}}/api/purchase-orders/{{orderId}}/cancel
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "reason": "Fornecedor sem estoque para o restante", "rowVersion": "{{orderRowVersionAfterReceipt}}" }

### Pedido com itens e notas -> 200 (preço da nota ao lado do preço do pedido)
GET {{host}}/api/purchase-orders/{{orderId}}
Authorization: Bearer {{token}}

### Pedidos cancelados -> 200
GET {{host}}/api/purchase-orders?status=Cancelled
Authorization: Bearer {{token}}

### Histórico do lote comprado -> 200, um movimento PurchaseReceipt de +20
GET {{host}}/api/movements?productId={{productId}}&storageId={{storageId}}&batch=LOTE-COMPRA-01
Authorization: Bearer {{token}}


### =====================================================
### CLIENTES E FATURAMENTO
### =====================================================

### Criar cliente -> 201 (CNPJ aleatório, só dígitos)
# @name createCustomer
POST {{host}}/api/customers
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "name": "Empório Flor do Campo", "document": "33444555{{$randomInt 100000 999999}}", "email": "compras@flordocampo.dev", "phone": "(11) 3333-2222" }

### Pedido maior que o saldo disponível -> 422 (informa disponível e pedido)
POST {{host}}/api/sales-orders
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "customerId": "{{customerId}}", "storageId": "{{storageId}}", "paymentMethod": "Boleto", "items": [ { "productId": "{{productId}}", "quantity": 99999 } ] }

### Pedido no Pix -> 400 (por enquanto só boleto)
POST {{host}}/api/sales-orders
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "customerId": "{{customerId}}", "storageId": "{{storageId}}", "paymentMethod": "Pix", "items": [ { "productId": "{{productId}}", "quantity": 1 } ] }

### Criar pedido de venda: 5 unidades no boleto -> 201, status AwaitingPayment, boleto emitido
# @name createSale
POST {{host}}/api/sales-orders
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "customerId": "{{customerId}}", "storageId": "{{storageId}}", "paymentMethod": "Boleto", "notes": "Entrega na loja", "items": [ { "productId": "{{productId}}", "quantity": 5 } ] }

### Emitir nota antes do pagamento -> 422
POST {{host}}/api/invoices
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "salesOrderId": "{{saleId}}", "rowVersion": "{{saleRowVersion}}" }

### Excluir cliente com pedido aguardando pagamento -> 422
DELETE {{host}}/api/customers/{{customerId}}
Authorization: Bearer {{token}}

### Simular o pagamento do boleto -> 200, status Paid
# @name paySale
POST {{host}}/api/sales-orders/{{saleId}}/boleto/payment
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "rowVersion": "{{saleRowVersion}}" }

### Pagar de novo com a versão velha -> 409
POST {{host}}/api/sales-orders/{{saleId}}/boleto/payment
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "rowVersion": "{{saleRowVersion}}" }

### Emitir a nota -> 201, itens por lote (FIFO); o estoque cai 5
POST {{host}}/api/invoices
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{ "salesOrderId": "{{saleId}}", "rowVersion": "{{saleRowVersionAfterPayment}}" }

### Pedido faturado -> 200, status Invoiced com o número da nota
GET {{host}}/api/sales-orders/{{saleId}}
Authorization: Bearer {{token}}

### Notas emitidas -> 200
GET {{host}}/api/invoices
Authorization: Bearer {{token}}

### Histórico do lote vendido -> 200, movimento SalesInvoice negativo
GET {{host}}/api/movements?productId={{productId}}&storageId={{storageId}}
Authorization: Bearer {{token}}
